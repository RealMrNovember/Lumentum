{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumentum.cicibyte.com/schemas/token.json",
  "title": "TokenData",
  "description": "RSVP okuma motoru tek kelime çıktısı — tüm platformlarda ortak",
  "type": "object",
  "required": ["token", "focus_index", "pace_ms"],
  "properties": {
    "token": {
      "type": "string",
      "description": "Gösterilecek kelime veya parça"
    },
    "focus_index": {
      "type": "integer",
      "minimum": 0,
      "description": "ORP odak harfinin token içindeki karakter indeksi"
    },
    "pace_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Bu token'ın ekranda kalma süresi (milisaniye)"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["sentence_end", "technical_term", "skip"]
      },
      "description": "İsteğe bağlı motor bayrakları (Faz 1+)"
    }
  },
  "additionalProperties": false
}
